# Backend URL used by the server. Use HTTPS for production and set it at build time too.
API_BASE_URL=http://localhost:4000
# Public browser origins, comma separated (needed behind a reverse proxy).
APP_ORIGINS=http://localhost:3000
# Set only when the reverse proxy overwrites X-Forwarded-For with the client IP.
TRUST_PROXY=0
# Local file-based admin mode only; use random secrets and your own credentials.
# ADMIN_SESSION_SECRET=
# ADMIN_DEFAULT_USERNAME=
# ADMIN_DEFAULT_PASSWORD=
